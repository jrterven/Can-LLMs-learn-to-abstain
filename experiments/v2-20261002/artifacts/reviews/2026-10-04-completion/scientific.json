  "claims": [
    {
      "intervention": "Larger credit groups B−A",
      "support": "Not established",
      "reason": "Both datasets have confidence intervals crossing zero; paired seed effects change sign. Positive means are not reliable evidence of a benefit."
    },
    {
      "intervention": "Paired threshold exposures C−B and conditioned vs fixed C−D",
      "support": "Not established",
      "reason": "All four dataset-specific intervals cross zero; seed43 reverses both contrasts. C is more conservative than D, but C does not show a larger aggregate primary-threshold coverage response on TriviaQA. Do not claim learned useful threshold control from coverage alone."
    },
    {
      "intervention": "Learned calibrated selector",
      "support": "Supported on the registered TriviaQA utility comparisons; positive descriptive transfer relative to both cheap filters",
      "reason": "All three seed effects positive for both comparators and both datasets; all99% intervals above zero. On TriviaQA coverage increases while selective risk decreases. On NQ utility remains negative, so performance still loses to always abstaining at utility0."
    }
  ],
  "limits": [
    "Only three training seeds; intervals conditional on one fixed TRAIN candidate bank and fitted calibrators; no candidate-regeneration or calibration-resampling uncertainty.",
    "NQ has500 questions and is descriptive transfer, not a second confirmatory family. Positive relative effects do not imply positive absolute utility or meeting requested risk thresholds.",
    "Strict exact match is the endpoint; no new human audit completed here. The selector learns correctness under that verifier, not guaranteed factual truth.",
    "Equal-label logistic comparator matches labels but not capacity or compute. No matched-inference-cost benchmark is introduced post hoc.",
    "C−B changes threshold exposure and batch balance; no G4 paired arm to isolate an interaction.",
    "Do not compare v2 versus v1 as a causal ablation: multiple recipe, budget and test-population differences.",
    "A29 is a severe abstention-collapse seed; report all seeds rather than removing it. Forced TriviaQA coverage .118, NQ .042."
  ],
